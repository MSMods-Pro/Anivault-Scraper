PORT=3000
NODE_ENV=development

# Upstash Redis (optional)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Cache TTL in seconds
CACHE_TTL_MAPPING=86400
CACHE_TTL_EPISODES=3600
CACHE_TTL_STREAM=300

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=60

# TMDB — used by src/scrapers/tmdb.ts for /api/tmdb/episode-thumb
TMDB_API_KEY=

# Anikoto — official primary domain (override with another verified mirror if needed)
ANIKOTO_BASE_URL=https://anikototv.to

# Optional provider base URLs (override when upstream domains change)
